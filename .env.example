# Governance index database. The npm CLI reads libpq's native PG* variables.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gavel
PGUSER=gavel
PGPASSWORD=change-me
POSTGRES_PASSWORD=change-me
GAVEL_INDEXER_DB_PASSWORD=change-me-indexer
GAVEL_API_DB_PASSWORD=change-me-api-readonly

# Sources and indexer runtime
ETHEREUM_RPC_URL=https://eth.drpc.org
NOUNS_SUBGRAPH_URL=https://www.nouns.camp/subgraphs/nouns
INDEXER_ENABLED_DAOS=nouns,ens
INDEXER_CONFIRMATION_DEPTH=12
INDEXER_BLOCK_BATCH_SIZE=20000
INDEXER_RPC_CONCURRENCY=4
INDEXER_DB_POOL_SIZE=10
# Optional override. Verified default: Voting creation block 15505853.
RAILGUN_FROM_BLOCK=15505853

# Read-only API
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
GAVEL_INDEX_API_URL=http://localhost:8080

# Reserved for a future Tally source; Tally ingestion is not implemented.
TALLY_API_KEY=
TALLY_API_URL=https://api.tally.xyz/query

# Existing private runtime configuration
GAVEL_DATA_DIR=
GAVEL_MODEL_ADDRESS=
GAVEL_ASSET_OWNER_ADDRESS=
GAVEL_SAFE_ADDRESS=
GAVEL_WAAP_ADDRESS=
# Legacy direct-signing scripts only.
AGENT_PRIVATE_KEY=

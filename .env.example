# Governance index database. The npm CLI reads libpq's native PG* variables.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gavel
PGUSER=gavel
PGPASSWORD=[REDACTED]
POSTGRES_PASSWORD=[REDACTED]
# Application role credentials. init-db.sh uses them on a fresh volume; the
# migrate service uses them to create the roles on an existing one.
GAVEL_INDEXER_DB_PASSWORD=[REDACTED]
GAVEL_API_DB_PASSWORD=[REDACTED]
GAVEL_GATE_DB_PASSWORD=[REDACTED]

# Sources and indexer runtime
ETHEREUM_RPC_URL=https://eth.drpc.org
# Upstream source for this indexer, and the CLI's `--endpoint` opt-out target.
NOUNS_SUBGRAPH_URL=https://www.nouns.camp/subgraphs/nouns
INDEXER_ENABLED_DAOS=nouns,ens
INDEXER_CONFIRMATION_DEPTH=64
# Upper bound on every `eth_getLogs` span the indexer requests. Hosted providers
# cap this; the free dRPC tier above rejects anything over 10000 blocks, so the
# default stays conservatively below that. Raise it only for a provider you have
# confirmed allows wider ranges.
INDEXER_BLOCK_BATCH_SIZE=5000
# Optional narrower bound for ENS ProposalCreated discovery only. Unset means
# INDEXER_BLOCK_BATCH_SIZE, and unset again means the 5000-block default.
ENS_PROPOSAL_BLOCK_BATCH_SIZE=
INDEXER_RPC_CONCURRENCY=4
INDEXER_DB_POOL_SIZE=10
# How often the indexer re-enumerates every proposal to detect deletions. This is
# a reconciliation sweep only: ordinary lifecycle correctness does not depend on
# it, so raising it costs integrity auditing, never correct proposal status.
INDEXER_FULL_SCAN_INTERVAL_SECONDS=21600
# How long a WARM proposal (succeeded, queued -- won its vote, can still be
# queued, executed, vetoed or expired) may go unrefreshed. HOT proposals are read
# every cycle and FINAL ones are never read again, so this is the only knob that
# trades freshness for upstream requests.
INDEXER_WARM_REFRESH_SECONDS=900
# `gavel-indexer health` fails once a checkpoint stops advancing for this long.
INDEXER_MAX_CHECKPOINT_AGE_SECONDS=900
# Optional override. Verified default: Voting creation block 15505853.
RAILGUN_FROM_BLOCK=15505853

# Read-only API
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
# Optional override. Unset, clients read the public index at
# https://index.0773h.com for every DAO; set it to point them at this deployment.
# Put no credentials in this URL; see packages/governance-index/README.md.
GAVEL_INDEX_API_URL=http://localhost:8080
# The CLI refuses to build a history document from an index older than this.
GAVEL_INDEX_MAX_STALENESS_SECONDS=3600

# Reserved for a future Tally source; Tally ingestion is not implemented.
TALLY_API_KEY=
TALLY_API_URL=https://api.tally.xyz/query

# Existing private runtime configuration
GAVEL_DATA_DIR=
GAVEL_MODEL_ADDRESS=
GAVEL_ASSET_OWNER_ADDRESS=
GAVEL_SAFE_ADDRESS=
GAVEL_WAAP_ADDRESS=

# Execution identities. Gavel never reads a private key from configuration:
# an execution profile names a credential reference (local:, keychain:,
# remote:) and the backend resolves it. `gavel identity create --type
# safe-proposer` writes an encrypted keystore under GAVEL_DATA_DIR; this
# passphrase decrypts it and is never written to disk. Minimum 12 characters.
# See docs/architecture/execution.md section 9.
GAVEL_IDENTITY_PASSPHRASE=

# Legacy direct-signing scripts under nouns-dao/scripts only. NOT used by the
# execution layer, which depends on the SigningIdentity abstraction instead. A
# plaintext key here is a development-only backend; production should use an OS
# keychain, an encrypted keystore, or a KMS/HSM-backed signer.
AGENT_PRIVATE_KEY=

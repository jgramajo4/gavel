{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gavel.local/schemas/gavel-gate-base-sepolia-deployment.schema.json",
  "title": "Gavel Gate Base Sepolia test-only deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "chainId", "sourceCommit", "token", "splitter"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "test" },
    "chainId": { "const": "84532" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "token": { "$ref": "#/$defs/token" },
    "splitter": { "$ref": "#/$defs/splitter" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$" },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "block"],
      "properties": {
        "hash": { "$ref": "#/$defs/bytes32" },
        "block": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeBytecode", "runtimeCodeHash"],
      "properties": {
        "runtimeBytecode": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})+$" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "productionSafe", "address", "deployment", "code", "name", "version", "symbol", "decimals", "domainSeparator"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "productionSafe": { "const": false },
        "address": { "$ref": "#/$defs/address" },
        "deployment": { "$ref": "#/$defs/transaction" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "const": "USD Coin" },
        "version": { "const": "2" },
        "symbol": { "const": "USDC" },
        "decimals": { "const": 6 },
        "domainSeparator": { "$ref": "#/$defs/bytes32" }
      }
    },
    "splitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "deployment", "code", "token", "gavelRecipient", "quoteSigner", "gavelFeeAmount", "domainSeparator"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "deployment": { "$ref": "#/$defs/transaction" },
        "code": { "$ref": "#/$defs/code" },
        "token": { "$ref": "#/$defs/address" },
        "gavelRecipient": { "$ref": "#/$defs/address" },
        "quoteSigner": { "$ref": "#/$defs/address" },
        "gavelFeeAmount": { "const": "250000" },
        "domainSeparator": { "$ref": "#/$defs/bytes32" }
      }
    }
  }
}

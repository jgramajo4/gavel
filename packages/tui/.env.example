# Migrated TUI endpoint configuration. Direct signing is intentionally disabled.
# Gavel configuration — copy to .env (the wizard writes this for you).
#
# exported into the shell that launches Gavel — never persisted here.

# Ethereum RPC endpoint. Default is a keyless decentralized aggregator.
# Paste an Alchemy/Infura/etc. URL for higher rate limits.
RPC_URL=https://eth.drpc.org

# Optional: pin a specific Nouns subgraph endpoint. Leave unset to use the
# hardcoded default.
# SUBGRAPH_URL=

# Optional: override the EAS GraphQL indexer (mainnet default).
# EAS_GRAPHQL_URL=https://easscan.org/graphql

# Optional: override the prediction (Gradio Space) endpoint.
# PREDICTION_URL=https://gramajo-nouns-proposal-check.hf.space


{
  "name": "gavel",
  "version": "0.2.0",
  "private": true,
  "description": "A private, history-first AI governance copilot.",
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gavel": "packages/cli/bin/gavel.js",
    "gavel-indexer": "packages/governance-index/bin/gavel-indexer.js"
  },
  "scripts": {
    "gavel": "node packages/cli/bin/gavel.js",
    "indexer": "node packages/governance-index/bin/gavel-indexer.js",
    "test": "node --test test/*.test.js packages/*/test/*.test.js",
    "test:history": "node --test test/history*.test.js",
    "test:profile": "node --test test/profile.test.js",
    "test:prediction": "node --test test/prediction.test.js",
    "test:backtest": "node --test test/backtest.test.js",
    "test:security": "node --test test/security.test.js",
    "test:bankr-skill": "node --test test/bankr-skill.test.js",
    "test:prepare-vote": "node --test test/vote-preparation.test.js",
    "test:safe-live": "node --test test/safe-live-integration.test.js",
    "tui": "npm run dev --workspace @gavel/tui",
    "tui:build": "npm run build --workspace @gavel/tui",
    "tui:typecheck": "npm run typecheck --workspace @gavel/tui",
    "gate-web": "npm run dev --workspace @gavel/gate-web",
    "gate-web:build": "npm run build --workspace @gavel/gate-web",
    "gate-web:test": "npm test --workspace @gavel/gate-web",
    "gate-web:typecheck": "npm run typecheck --workspace @gavel/gate-web"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0"
  }
}

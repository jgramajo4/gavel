# Canonical Gavel server (packages/server) runtime configuration.
#
# This file documents the ONE canonical `packages/server` deployment that hosts
# the Gate HTTP routes and workers. It is not the root application `.env`, and
# the Gate quote signer below MUST NOT be copied into it, into the indexer, into
# the Cloudflare index worker, into the CLI config, into Postgres, or into any
# browser bundle. Values here are placeholders; real values live in the
# deployment secret store (Railway secrets, or a 0600 host secret file locally).

# --- Gate database (least-privilege gavel_gate role only) ---------------------
GAVEL_GATE_DATABASE_URL=postgres://gavel_gate:CHANGE_ME@localhost:5432/gavel

# --- Gate quote signer (PR 5) -------------------------------------------------
# Dedicated, no-funds signing key used ONLY to sign the EIP-712 Quote struct.
# It cannot move money by itself: settlement additionally requires the payer's
# EIP-3009 authorization, and the splitter routes fixed legs only. Hold no
# intended USDC balance and no ETH beyond operational gas dust.
#
# Prefer an injected signing interface (KMS/HSM) over a raw key in production;
# `createQuoteSignerFromEnv` reads this variable only in the Gate service
# runtime. It is never logged: signatures and 32-byte hex runs are redacted.
# Rotation is a draining deployment migration: pause old issuance; wait for
# every old quote to expire and reconcile; deploy and verify the new splitter;
# switch only new issuance; then resume. Keep the old deployment configured and
# scanned until every accepted monitor completes its final 64-confirmation
# check. Follow docs/deployment/GAVEL_GATE_EXPERIMENTAL.md exactly.
GAVEL_GATE_QUOTE_SIGNER=
# Optional public cross-check. Startup fails closed if it does not match the
# address derived from GAVEL_GATE_QUOTE_SIGNER.
GAVEL_GATE_QUOTE_SIGNER_ADDRESS=

# --- Base settlement deployment ----------------------------------------------
# Production (exact pair): environment=production, chain=8453, and canonical
# Base native USDC. Leave GAVEL_GATE_TEST_TOKEN_LABEL unset.
GAVEL_GATE_ENVIRONMENT=production
GAVEL_GATE_BASE_CHAIN_ID=8453
GAVEL_GATE_BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia test-only alternative: set environment=test, chain=84532, the
# explicitly deployed test-token address, and a nonblank test-only label. Never
# reuse the production token placeholder or infer/invent a test-token address.
# GAVEL_GATE_ENVIRONMENT=test
# GAVEL_GATE_BASE_CHAIN_ID=84532
# GAVEL_GATE_BASE_USDC=0x_TEST_TOKEN_DEPLOYMENT_ADDRESS
# GAVEL_GATE_TEST_TOKEN_LABEL=base-sepolia-test-token
GAVEL_GATE_SPLITTER=
# Historical code calls this the owner recipient; it is the immutable Gavel
# recipient from the splitter constructor (not an admin/owner capability).
GAVEL_GATE_OWNER_RECIPIENT=
GAVEL_GATE_BASE_RPC_URL=
GAVEL_GATE_BASE_VERIFIER=

# --- Canonical governance index (read-only) -----------------------------------
GAVEL_GATE_INDEX_URL=http://localhost:8080
# Ethereum mainnet (chain 1). Backs Nouns voting power, ERC-1271 verification
# for contract wallets, AND the public projection's ENS display name, which is
# resolved here rather than in the browser so every client — the web app, a
# Bankr advocate, the CLI — sees the same label without holding an endpoint of
# its own. Resolution is reverse + forward verified and display only: a name is
# never an authorization identity, a route, or quote material. An unreachable
# endpoint degrades a Gate to its shortened address; it never fails a read.
GAVEL_GATE_ETHEREUM_RPC_URL=
GAVEL_GATE_DAO_VERIFIER=
GAVEL_GATE_NOUNS_FRESHNESS_SECONDS=900

# --- Gate API session binding -------------------------------------------------
GAVEL_GATE_API_AUDIENCE=gate.local
# Sessions are opaque random values stored only as hashes; there is no shared
# session-signing secret.
# Comma-separated exact HTTPS origins allowed to call this API from a browser
# (CORS). Empty means no CORS headers are emitted and the API stays
# same-origin/local-only. No wildcard is ever accepted.
# GAVEL_GATE_CORS_ORIGINS=https://gate.0773h.com
GAVEL_GATE_HOST=0.0.0.0
GAVEL_GATE_PORT=8080

# --- Bounded settlement workers ----------------------------------------------
GAVEL_GATE_CONFIRMATION_DEPTH=1
GAVEL_GATE_REORG_OVERLAP_BLOCKS=64
GAVEL_GATE_REORG_MONITOR_CONFIRMATIONS=64
GAVEL_GATE_SETTLEMENT_MAX_BLOCK_RANGE=5000
GAVEL_GATE_SETTLEMENT_POLL_INTERVAL_MS=5000
GAVEL_GATE_BASE_RPC_TIMEOUT_MS=10000
GAVEL_GATE_NOTIFICATION_LEASE_MS=300000

# --- Private notification provider -------------------------------------------
# Keep this explicit. Set to agentmail only when every commented value below is
# supplied from the deployment secret store; partial configuration fails startup.
GAVEL_GATE_NOTIFIER_MODE=disabled
# GAVEL_GATE_ENCRYPTION_KEY=primary:<43-character-base64url-encoded-32-byte-key>
# AGENTMAIL_API_KEY=<agentmail-api-key>
# AGENTMAIL_FROM_INBOX=<sender-inbox-address>
# Optional; exact allowlisted HTTPS origin only. Defaults to api.agentmail.to.
# AGENTMAIL_API_URL=https://api.agentmail.to
